---
const links = [
  { href: "#hero", label: "首頁" },
  { href: "#products", label: "產品目錄" },
  { href: "#about", label: "公司介紹" },
  { href: "/services/medical-ai-academy", label: "白袍 AI 學院" },
];
---

<nav class="navbar">
  <div class="nav-container">
    <a href="/" class="logo">子彥好棒棒有限公司</a>
    <ul class="nav-links">
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);
    z-index: 1000;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 64px;
  }

  .logo {
    font-size: 1.4rem;
    font-weight: 700;
    color: #4361ee;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 2rem;
  }

  .nav-links a {
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: #4361ee;
  }

  @media (max-width: 640px) {
    .nav-links {
      gap: 1rem;
      font-size: 0.9rem;
    }
  }
</style>
